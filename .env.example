# Copy this file to .env and add your keys
# Get your keys:
# - GROQ_API_KEY: https://console.groq.com/ (free tier with high rate limits)
# - CLOUDFLARE_API_TOKEN: https://dash.cloudflare.com/ (optional screen-vision fallback)
# - CLOUDFLARE_ACCOUNT_ID: https://dash.cloudflare.com/ (optional screen-vision fallback)
# - AUDIO_INPUT_DEVICE: device index for the microphone to use (optional on systems with a single mic)
# - AUDIO_INPUT_DEVICE_NAME: friendly name for the preferred mic (optional)
# - GOOGLE_MAPS_API_KEY: optional Google Maps key for place search
# - GROQ_MODEL: model to use for Groq requests, e.g. llama-3.3-70b-versatile

GROQ_API_KEY=your_groq_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
AUDIO_INPUT_DEVICE=
AUDIO_INPUT_DEVICE_NAME=
GOOGLE_MAPS_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
USER_NAME=Your Name
ASSISTANT_NAME=JARVIS
ADDRESS_AS=Sir
